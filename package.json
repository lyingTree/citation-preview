{
  "name": "citation-preview",
  "version": "1.1.1",
  "description": "Preview numeric citation groups in Page preview using the numbered bibliography in the same note.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run build && npm run test && npm run lint",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "obsidian",
    "citations",
    "bibliography",
    "hover",
    "references"
  ],
  "author": "Chuangwu Deng",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2",
    "obsidian": "^1.8.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
